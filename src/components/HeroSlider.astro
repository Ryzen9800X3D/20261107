---
interface Props {
  articles: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: string;
      image?: string;
    };
  }[];
}
const { articles } = Astro.props;
---

<section class="hero-slider-section" id="heroSlider">
  {articles.map((article, i) => (
    <div class={`slide${i === 0 ? ' active' : ''}`}>
      <div
        class="slide-bg"
        style={`background-image: url('${article.data.image ? article.data.image + '?auto=format&fit=crop&w=1920&q=80' : "https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1920&q=80"}');`}
      ></div>
      <div class="slide-overlay"></div>
      <div class="slide-content container">
        <h1>{article.data.title}</h1>
        <p>{article.data.description}</p>
        <a href={`/news/${article.slug}`} class="btn btn-primary">了解更多</a>
      </div>
    </div>
  ))}
  <div class="slider-dots">
    {articles.map((_, i) => (
      <span class={`dot${i === 0 ? ' active' : ''}`} data-slide={i + 1}></span>
    ))}
  </div>
</section>

<script is:inline>
(function(){
    var slides = document.querySelectorAll('#heroSlider .slide');
    var dots = document.querySelectorAll('#heroSlider .dot');
    var current = 0;
    var timer = null;

    function show(n) {
        current = ((n - 1) + slides.length) % slides.length;
        slides.forEach(function(s){ s.classList.remove('active'); });
        dots.forEach(function(d){ d.classList.remove('active'); });
        slides[current].classList.add('active');
        dots[current].classList.add('active');
    }

    function go(n) {
        show(n);
        clearInterval(timer);
        timer = setInterval(function(){ show((current % slides.length) + 2); }, 5000);
    }

    dots.forEach(function(d, i){
        d.addEventListener('click', function(){ go(i + 1); });
    });

    timer = setInterval(function(){ show((current % slides.length) + 2); }, 5000);
    if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', function(){ show(1); });
    } else {
        show(1);
    }
})();
</script>

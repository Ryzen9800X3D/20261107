<script is:inline>
(function(){
    var slides = document.querySelectorAll('#heroSlider .slide');
    var dots = document.querySelectorAll('#heroSlider .dot');
    var current = 0;
    var timer = null;

    function show(n) {
        current = ((n - 1) + slides.length) % slides.length;
        slides.forEach(function(s){ s.classList.remove('active'); });
        dots.forEach(function(d){ d.classList.remove('active'); });
        slides[current].classList.add('active');
        dots[current].classList.add('active');
    }

    function go(n) {
        show(n);
        clearInterval(timer);
        timer = setInterval(function(){ show((current % slides.length) + 2); }, 5000);
    }

    dots.forEach(function(d, i){
        d.addEventListener('click', function(){ go(i + 1); });
    });

    timer = setInterval(function(){ show((current % slides.length) + 2); }, 5000);
    if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', function(){ show(1); });
    } else {
        show(1);
    }
})();
</script>
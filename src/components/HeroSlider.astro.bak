---
import { getCollection } from 'astro:content';

// Fetch latest news articles for hero slider
const allNews = await getCollection('news');
const featuredPosts = allNews
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 6);
---

<section class="hero-slider-section" id="heroSlider">
	{#each featuredPosts as post, index}
	<div class:list={['slide', {'active': index === 0}]}>
		<!-- Use article image or fallback to default bg -->
		<div class="slide-bg slide-bg-image" style={`background-image: url('${post.data.image || "/images/AI.png"}')`}></div>
		<div class="slide-overlay"></div>
		<div class="slide-content container">
			<h1>{post.data.title}</h1>
			<p>{post.data.description}</p>
			<a href={`/news/${post.slug}`} class="btn btn-primary">了解更多</a>
		</div>
	</div>
	{/each}

	<div class="slider-dots">
		{#each featuredPosts as _, index}
			<span data-index={index + 1}><span></span></span>
		{/each}
	</div>
</section>

<script>
	const totalSlides = document.querySelectorAll('.slide').length;
	if (totalSlides > 0) {
		let currentSlide = 1;
		let slideInterval;

		function goToSlide(n) {
			const slides = document.querySelectorAll('.slide');
			const dotWrappers = document.querySelectorAll('[data-index]');
			if (!slides.length) return;

			slides.forEach(s => s.classList.remove('active'));
			
			currentSlide = n;
			if (currentSlide > totalSlides) currentSlide = 1;
			if (currentSlide < 1) currentSlide = totalSlides;

			slides[currentSlide - 1].classList.add('active');
			
			dotWrappers.forEach((wrapper, i) => {
				wrapper.querySelector('span').classList.toggle('active-dot', i === currentSlide - 1);
			});
		}

		function nextSlide() {
			goToSlide(currentSlide + 1);
		}

		function startAutoSlide() {
			slideInterval = setInterval(nextSlide, 5000);
		}

		function stopAutoSlide() {
			clearInterval(slideInterval);
		}

		document.querySelectorAll('[data-index]').forEach(dotWrapper => {
			dotWrapper.addEventListener('click', () => {
				stopAutoSlide();
				goToSlide(parseInt(dotWrapper.getAttribute('data-index')));
				startAutoSlide();
			});
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') { stopAutoSlide(); goToSlide(currentSlide + 1); startAutoSlide(); }
			if (e.key === 'ArrowLeft') { stopAutoSlide(); goToSlide(currentSlide - 1); startAutoSlide(); }
		});

		startAutoSlide();
	}
</script>

<style>
.slider-dots span[data-index] > * { opacity: 0.4; transition: all 0.3s ease; display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #fff; margin: 0 6px; cursor: pointer; }
.active-dot { opacity: 1 !important; transform: scale(1.3); }

/* Slide image styling */
.slide-bg-image { background-size: cover; background-position: center; }
</style>

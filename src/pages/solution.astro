---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="解決方案 | InfoSecure 沅品科技">
  <Nav />
  
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>解決方案</h1>
      <div class="breadcrumb">
        <a href="/">首頁</a> <span>/</span> 解決方案
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="section-padding">
    <div class="container">
      <div class="solutions-grid">
        <!-- 伺服器 -->
        <div class="solution-card">
          <div class="card-icon">🖥️</div>
          <h2>伺服器</h2>
          <p>從入門級塔式伺服器到企業級關鍵任務主機，提供高效能運算力。</p>
          <ul>
            <li>HPE ProLiant 系列</li>
            <li>Dell PowerEdge 系列</li>
            <li>Lenovo ThinkSystem</li>
            <li>Huawei FusionServer</li>
          </ul>
          <a href="/#inquiry" class="btn btn-primary">立即諮詢</a>
        </div>

        <!-- 儲存 -->
        <div class="solution-card">
          <div class="card-icon">💾</div>
          <h2>儲存</h2>
          <p>無論傳統 SAN/NAS 或現代軟體定義儲存，提供完整資料保護方案。</p>
          <ul>
            <li>HPE Nimble / 3PAR</li>
            <li>Dell PowerStore / PowerVault</li>
            <li>Qsan XCubeNXT</li>
            <li>NetApp AFF / FAS</li>
            <li>HPE GreenLake</li>
          </ul>
          <a href="/#inquiry" class="btn btn-primary">立即諮詢</a>
        </div>

        <!-- 網路 -->
        <div class="solution-card">
          <div class="card-icon">🌐</div>
          <h2>網路</h2>
          <p>從園區網路到資料中心交換器，提供有线/無線整合方案。</p>
          <ul>
            <li>HPE Aruba 網路解決方案</li>
            <li>Juniper Networks</li>
            <li>園區/資料中心交換器</li>
            <li>網路安全閘道</li>
          </ul>
          <a href="/#inquiry" class="btn btn-primary">立即諮詢</a>
        </div>

        <!-- 軟體 -->
        <div class="solution-card">
          <div class="card-icon">🔐</div>
          <h2>軟體</h2>
          <p>虛擬化平台、備份還原、資料保護軟體一應俱全。</p>
          <ul>
            <li>VMware vSphere / vSAN</li>
            <li>Microsoft Hyper-V</li>
            <li>Veritas NetBackup</li>
            <li>Acronis 備份防護</li>
          </ul>
          <a href="/#inquiry" class="btn btn-primary">立即諮詢</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 諮詢表單 -->
  <section class="section-padding bg-light" id="inquiry">
    <div class="container">
      <div class="text-center" style="margin-bottom: 50px;">
        <h2>免費諮詢</h2>
        <p>我們的技術顧問將根據您的需求，提供最合適的解決方案</p>
      </div>
      <form class="inquiry-form">
        <div class="form-grid">
          <input type="text" placeholder="公司名稱" required />
          <input type="text" placeholder="聯絡人" required />
          <input type="email" placeholder="電子郵件" required />
          <input type="tel" placeholder="聯絡電話" />
          <select required>
            <option value="">請選擇感興趣的方案</option>
            <option>伺服器</option>
            <option>儲存</option>
            <option>網路</option>
            <option>軟體</option>
            <option>整體架構規劃</option>
          </select>
          <textarea placeholder="請描述您的需求..." rows="4"></textarea>
        </div>
        <div class="text-center" style="margin-top: 30px;">
          <button type="submit" class="btn btn-primary">送出諮詢</button>
        </div>
      </form>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1920&q=80');
    background-size: cover;
    background-position: center;
    padding: 100px 0;
    color: white;
    text-align: center;
  }
  .page-hero h1 { font-size: 3rem; margin-bottom: 20px; }
  .breadcrumb { font-size: 1rem; color: #ccc; }
  .breadcrumb a { color: #fff; }
  .breadcrumb span { margin: 0 10px; color: var(--brand-red); }
  .section-padding { padding: 80px 0; }
  .bg-light { background: #f9f9f9; }
  .text-center { text-align: center; }
  .text-center h2 { font-size: 2.5rem; margin-bottom: 15px; }
  .text-center p { color: #666; font-size: 1.1rem; }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }
  .solution-card {
    background: white;
    border-radius: 12px;
    padding: 40px 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border: 1px solid #f0f0f0;
    transition: all 0.3s;
  }
  .solution-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  .card-icon { font-size: 3rem; margin-bottom: 20px; }
  .solution-card h2 { font-size: 1.5rem; margin-bottom: 15px; color: var(--brand-dark); }
  .solution-card p { color: #666; margin-bottom: 20px; font-size: 0.95rem; }
  .solution-card ul { list-style: none; margin-bottom: 25px; }
  .solution-card li { padding: 6px 0; color: #555; font-size: 0.95rem; border-bottom: 1px solid #f5f5f5; }
  .solution-card li:last-child { border-bottom: none; }

  .inquiry-form .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 800px;
    margin: 0 auto;
  }
  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s;
  }
  .inquiry-form input:focus,
  .inquiry-form select:focus,
  .inquiry-form textarea:focus {
    outline: none;
    border-color: var(--brand-red);
  }
  .inquiry-form textarea { grid-column: 1 / -1; }

  .btn {
    display: inline-block;
    padding: 12px 35px;
    border-radius: 8px;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    border: none;
    font-size: 1.1rem;
    transition: all 0.3s;
  }
  .btn-primary {
    background-color: var(--brand-red);
    color: white;
    box-shadow: 0 8px 20px rgba(184, 37, 37, 0.4);
  }
  .btn-primary:hover {
    background-color: #8a1515;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .solutions-grid { grid-template-columns: 1fr; }
    .inquiry-form .form-grid { grid-template-columns: 1fr; }
    .page-hero h1 { font-size: 2.2rem; }
  }
</style>

<script>
  const form = document.querySelector('.inquiry-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const values = Object.fromEntries(data.entries());
    console.log('Form submitted:', values);
    alert('感謝您的諮詢！我們將儘快與您聯繫。');
    form.reset();
  });
</script>

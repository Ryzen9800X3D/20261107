---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { getCollection } from 'astro:content';

// Get all news, sort by pubDate desc, take latest 6
const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
const latestNews = sortedNews.slice(0, 6);
---

<BaseLayout title="InfoSecure 沅品科技 | 專業系統整合 SI 服務商" description="沅品科技成立於2009年，提供虛擬化建置、網路資安規劃、資料儲存備份、雲端服務及機房建置等全方位資訊解決方案。">
    <Nav />
    <HeroSlider articles={latestNews} />

    <section class="about-teaser-section">
        <div class="container">
            <div class="teaser-grid">
                <div class="teaser-img">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="InfoSecure Team">
                </div>
                <div class="teaser-content">
                    <h2>深耕資訊領域 17 年<br>您的最佳 SI 合作夥伴</h2>
                    <p>沅品科技創立於 2009 年，由專業技術團隊組成。我們致力於提供全方位的資訊設備整合方案，從售前諮詢、系統建置到售後維護。我們不只是設備供應商，更是協助您解決 IT 難題的顧問。</p>
                    <a href="/about" class="btn btn-outline">閱讀完整介紹 &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <section id="solutions" class="section-padding" style="background-color: var(--bg-light);">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">全方位解決方案</h2>
                <p class="section-subtitle">針對企業機房與網路環境，提供從規劃、建置到維運的完整服務。</p>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="icon-box">🖥️</div>
                    <h3>虛擬化及超融合架構規劃建置</h3>
                    <p>超融合架構、VMware/Proxmote、資源池化與節能佈署。</p>
                    <span class="feature-tech">Ex : VMWare、Hyper-V、Proxmox</span>
                </div>
                <div class="feature-card">
                    <div class="icon-box">🛡️</div>
                    <h3>網路資安規劃</h3>
                    <p>提供適用的網路拓璞、內外部與無線網路架構。建置高可用性、高安全性及高效率的網路環境。</p>
                    <span class="feature-tech">Ex : Cisco、Fortinet、Palo Alto Networks、 HPE/Aruba/Juniper、NetGear</span>
                </div>
                <div class="feature-card">
                    <div class="icon-box">💾</div>
                    <h3>資料儲存備份備援</h3>
                    <p>建立完整備份機制與異地備援，降低天災人禍風險。縮短災難復原時間，避免營業損失。</p>
                    <span class="feature-tech">EX : NetApp、DELL、QSAN、Veeam、Acronis</span>
                </div>
                <div class="feature-card">
                    <div class="icon-box">🔒</div>
                    <h3>資料安全及端點防護</h3>
                    <p>內外網防火牆建置、端點防護、威脅及資料過濾。給予資料適當保護，避免遭受內外威脅及外洩。</p>
                    <span class="feature-tech">EX : Fortinet、Palo Alto Networks、Team T5、Kaspersky</span>
                </div>
                <div class="feature-card">
                    <div class="icon-box">☁️</div>
                    <h3>AI Agent代理與資料連結整合</h3>
                    <p>內部多系統(ERP、MES、CRM、HRM等)及檔案資料整合分析。行銷數據分析及客戶行為預測。</p>
                </div>
                <div class="feature-card">
                    <div class="icon-box">🛠️</div>
                    <h3>資訊系統委外服務</h3>
                    <p>依照客戶需求等級，提供專業到府或線上軟硬體維護服務，協助故障排除及問題解決。</p>
                </div>
            </div>
        </div>
    </section>

    <section id="cases" class="section-padding products-section">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">成功案例實績</h2>
                <p class="section-subtitle">感謝眾多企業夥伴的信賴，我們致力於為不同產業提供最適切的 IT 服務。</p>
            </div>
            <div class="product-category">
                <img src="/images/case-1.png" alt="Server Room" class="cat-img">
                <div class="cat-content">
                    <h3>跨國機械製造公司</h3>
                    <p>超融合設備規劃與建置，協助客戶串聯既有 IT 環境，建構出高一致性與高可用性的基礎架構平台。</p>
                    <p>強化風險控管能力，包含節點容錯、即時資料保護與快速災難復原，確保企業關鍵服務持續運作不中斷。</p>
                    <p>成本最佳化，簡化管理提升MIS團隊管理效率。</p>
                </div>
            </div>
            <div class="product-category">
                <img src="/images/case-2.png" alt="Storage System" class="cat-img">
                <div class="cat-content">
                    <h3>傳統產業公司</h3>
                    <p>提供 VMware 虛擬化建置與技術顧問服務，協助企業規劃與導入 vSphere / vCenter 架構。</p>
                    <p>完整的 VM 移轉降低導入風險並確保服務不中斷。活化機房空間，大幅降低實體伺服器數量。</p>
                </div>
            </div>
            <div class="text-center" style="margin-top: 50px;">
                <a href="/case" class="btn-more-news">查看更多成功案例 <span style="margin-left: 8px;">→</span></a>
            </div>
        </div>
    </section>

    <section id="products" class="section-padding products-section">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">產品資訊及合作夥伴</h2>
                <p class="section-subtitle">整合各大品牌設備及架構方案，提供客戶最穩定的基礎架構。</p>
            </div>
            <div class="product-category">
                <img src="/images/virtualization.png" alt="Server Room" class="cat-img">
                <div class="cat-content">
                    <h3>運算與虛擬化</h3>
                    <p>針對企業關鍵任務應用，提供業界最穩定的伺服器解決方案與虛擬化平台建置。</p>
                    <div class="brand-badges">
                        <span class="badge">HP Enterprise</span>
                        <span class="badge">HPE SimpliVity</span>
                        <span class="badge">DELL Technologies</span>
                        <span class="badge">VMware</span>
                        <span class="badge">Microsoft Hyper-V</span>
                        <span class="badge">Citrix</span>
                        <span class="badge">Lenovo</span>
                        <span class="badge">Fujitsu(Fsas)</span>
                        <span class="badge">Cisco</span>
                        <span class="badge">3Gen</span>
                        <span class="badge">Nutanix</span>
                        <span class="badge">Proxmox VE</span>
                    </div>
                </div>
            </div>
            <div class="product-category">
                <img src="/images/storage.png" alt="Storage System" class="cat-img">
                <div class="cat-content">
                    <h3>資料儲存及備份備援</h3>
                    <p>協助企業打造統一儲存架構與完整的備份機制。支援 SAN/NAS 整合及災難復原方案。</p>
                    <div class="brand-badges">
                        <span class="badge">Dell Technologies</span>
                        <span class="badge">NetApp</span>
                        <span class="badge">Hewlett Packard Enterprise (HPE)</span>
                        <span class="badge">Hitachi Vantara</span>
                        <span class="badge">Lenovo</span>
                        <span class="badge">3Gen</span>
                        <span class="badge">QSAN</span>
                        <span class="badge">Synology</span>
                        <span class="badge">QNAP</span>
                        <span class="badge">Veeam</span>
                        <span class="badge">Acronis</span>
                        <span class="badge">NAKIVO</span>
                    </div>
                </div>
            </div>
            <div class="product-category">
                <img src="/images/network topology.png" alt="Networking Switch" class="cat-img">
                <div class="cat-content">
                    <h3>網路資安規劃</h3>
                    <p>提供適用的網路拓璞、內外部與無線網路架構。建置高可用性、高安全性及高效率的網路環境。</p>
                    <div class="brand-badges">
                        <span class="badge">Fortinet</span>
                        <span class="badge">HPE/Aruba/Juniper</span>
                        <span class="badge">Cisco</span>
                        <span class="badge">Palo Alto Networks</span>
                        <span class="badge">Juniper</span>
                        <span class="badge">NETGEAR</span>
                        <span class="badge">Ruckus</span>
                        <span class="badge">Sophos</span>
                    </div>
                </div>
            </div>
            <div class="product-category">
                <img src="/images/security.png" alt="Networking Switch" class="cat-img">
                <div class="cat-content">
                    <h3>資料安全及端點防護</h3>
                    <p>內外網防火牆建置、端點防護、威脅及資料過濾。給予資料適當保護，避免遭受內外威脅及外洩。</p>
                    <div class="badge-group">
                        <span class="badge">Fortinet</span>
                        <span class="badge">Team T5</span>
                        <span class="badge">Kaspersky</span>
                        <span class="badge">Palo Alto Networks</span>
                        <span class="badge">Juniper</span>
                        <span class="badge">CrowdStrike</span>
                        <span class="badge">ShareTech</span>
                        <span class="badge">Trend Micro</span>
                        <span class="badge">UPAS</span>
                        <span class="badge">N-Partner</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="inquiry" class="section-padding" style="background: #fff;">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">產品諮詢及技術支援服務</h2>
                <p class="section-subtitle">有專案需求或產品疑問？歡迎填寫下方表單，我們將由專人為您服務。</p>
            </div>
            <div class="contact-form-container">
                <form action="https://formspree.io/f/xrerrdez" method="POST">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="name">聯絡人姓名 *</label>
                            <input type="text" id="name" name="name" class="form-control" required placeholder="例如：王大明">
                        </div>
                        <div class="form-group">
                            <label for="company">公司/單位名稱</label>
                            <input type="text" id="company" name="company" class="form-control" placeholder="例如：某某科技有限公司">
                        </div>
                        <div class="form-group">
                            <label for="phone">聯絡電話 *</label>
                            <input type="tel" id="phone" name="phone" class="form-control" required placeholder="0912-345678">
                        </div>
                        <div class="form-group">
                            <label for="email">電子信箱 *</label>
                            <input type="email" id="email" name="email" class="form-control" required placeholder="example@company.com">
                        </div>
                        <div class="form-full form-group">
                            <label for="product">感興趣的服務/解決方案</label>
                            <select id="product" name="product" class="form-control">
                                <option value="未指定">-- 請選擇 --</option>
                                <option value="Virtualization">虛擬化系統建置</option>
                                <option value="Network/Security">網路與資安規劃</option>
                                <option value="Storage/Backup">資料儲存備份</option>
                                <option value="Wireless">無線網路建置</option>
                                <option value="DataCenter">機房設備規劃</option>
                                <option value="Outsourcing">資訊委外服務</option>
                                <option value="Other">其他 / 專案諮詢</option>
                            </select>
                        </div>
                        <div class="form-full form-group">
                            <label for="message">需求說明及諮詢內容</label>
                            <textarea id="message" name="message" class="form-control" required placeholder="請簡單說明您的需求規格、預算或應用場景..."></textarea>
                        </div>
                        <div class="form-full text-center">
                            <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1.1rem;">確認送出</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <Footer />
</BaseLayout>

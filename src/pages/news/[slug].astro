---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
---

<BaseLayout title={`${entry.data.title} | InfoSecure 沅品科技`} description={entry.data.description}>
  <Nav />

  <!-- Page Hero with Logo -->
  <section class="page-hero">
    <div class="container">
      <h1>{entry.data.title}</h1>
      <div class="breadcrumb">
        <a href="/">首頁</a> <span>/</span> <a href="/news">最新消息</a> <span>/</span> 正文
      </div>
    </div>
  </section>

  <article class="article-wrap">
    <div class="container">
      <div class="article-inner">
        <div class="article-meta">
          <span class="article-tag">{entry.data.tag}</span>
          <span class="article-date">📅 {formatDate(entry.data.pubDate)}</span>
          <span class="article-author">✍️ {entry.data.author}</span>
        </div>

        {entry.data.image && (
          <img src={entry.data.image} class="featured-img" alt={entry.data.title} />
        )}

        <div class="article-content">
          <Content />
        </div>

        <div class="article-footer-nav">
          <a href="/news" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            回到最新消息列表
          </a>
          <a href="/#inquiry" class="btn btn-primary">立即預約諮詢服務</a>
          <a href="/" class="back-link">
            回到首頁
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </article>

  <Footer />

  <div class="back-to-top" id="backToTop" title="返回頂部">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m18 15-6-6-6 6"/></svg>
  </div>
</BaseLayout>

<script>
const backToTop = document.getElementById('backToTop');
window.addEventListener('scroll', () => {
  if (window.scrollY > 300) {
    backToTop?.classList.add('show');
  } else {
    backToTop?.classList.remove('show');
  }
});
backToTop?.addEventListener('click', () => {
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

// Code block copy button - per line
document.addEventListener('DOMContentLoaded', () => {
  const codeBlocks = document.querySelectorAll('.article-content pre');
  codeBlocks.forEach(pre => {
    // Skip if already has copy buttons
    if (pre.querySelector('.line-copy-btn')) return;
      
    const code = pre.querySelector('code')?.textContent || pre.textContent;
    const lines = code.split('\n');
    
    // Get language from class
    const langClass = Array.from(pre.classList).find(c => c.startsWith('language-')) || 'bash';
    const lang = langClass.replace('language-', '').toUpperCase();
    
    // Clear existing content
    pre.innerHTML = '';
    pre.style.position = 'relative';
    pre.style.paddingTop = '0';
    pre.style.borderRadius = '12px';
    pre.style.overflow = 'hidden';
    pre.style.border = '1px solid rgba(255,255,255,0.08)';
    pre.style.boxShadow = '0 8px 32px rgba(0,0,0,0.4)';
    
    // Create title bar
    const titleBar = document.createElement('div');
    titleBar.className = 'code-title-bar';
    titleBar.style.cssText = `
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: rgba(0, 0, 0, 0.3);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    `;
    
    // Left side: dots + language
    const leftSide = document.createElement('div');
    leftSide.style.cssText = 'display: flex; align-items: center; gap: 12px;';
    
    // Colored dots
    const dots = document.createElement('div');
    dots.style.cssText = 'display: flex; gap: 8px;';
    ['red', 'yellow', 'green'].forEach(color => {
      const dot = document.createElement('div');
      dot.style.cssText = `
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: ${color === 'red' ? '#FF5F56' : color === 'yellow' ? '#FFBD2E' : '#27C93F'};
        border: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.2);
      `;
      dots.appendChild(dot);
    });
    
    // Language label
    const langLabel = document.createElement('span');
    langLabel.style.cssText = `
      color: rgba(255, 255, 255, 0.5);
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.5px;
    `;
    langLabel.textContent = lang;
    
    leftSide.appendChild(dots);
    leftSide.appendChild(langLabel);
    
    // Right side: copy all button
    const allCopyBtn = document.createElement('button');
    allCopyBtn.className = 'all-copy-btn';
    allCopyBtn.title = '複製全部';
    allCopyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    allCopyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
        allCopyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#27C93F" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(() => {
          allCopyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        }, 2000);
      } catch (err) {
        console.error('複製失敗:', err);
      }
    });
    
    titleBar.appendChild(leftSide);
    titleBar.appendChild(allCopyBtn);
    
    // Create container for lines
    const linesContainer = document.createElement('div');
    linesContainer.className = 'code-lines';
    linesContainer.style.cssText = 'padding: 12px 16px; overflow-x: auto;';
    
    // Create each line with copy button
    lines.forEach((line, index) => {
      const lineDiv = document.createElement('div');
      lineDiv.className = 'code-line';
      lineDiv.style.cssText = `
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 2px 8px;
        border-radius: 6px;
        transition: all 0.15s ease;
        min-height: 24px;
        position: relative;
      `;
      
      // Line number
      const lineNum = document.createElement('span');
      lineNum.style.cssText = `
        color: rgba(255, 255, 255, 0.2);
        font-family: 'SF Mono', 'Fira Code', monospace;
        font-size: 12px;
        min-width: 24px;
        text-align: right;
        user-select: none;
        flex-shrink: 0;
      `;
      lineNum.textContent = index + 1;
      
      // Line content
      const lineContent = document.createElement('span');
      lineContent.className = 'code-line-content';
      lineContent.textContent = line;
      lineContent.style.cssText = `
        flex: 1;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 13px;
        line-height: 1.7;
        color: inherit;
        white-space: pre;
      `;
      
      // Copy button
      const copyBtn = document.createElement('button');
      copyBtn.className = 'line-copy-btn';
      copyBtn.title = '複製此行';
      copyBtn.style.cssText = `
        opacity: 0;
        background: transparent;
        border: none;
        padding: 4px;
        cursor: pointer;
        color: rgba(255, 255, 255, 0.3);
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 4px;
      `;
      copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(line);
          copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#27C93F" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(() => {
            copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
          }, 2000);
        } catch (err) {
          console.error('複製失敗:', err);
        }
      });
      
      // Hover effects
      lineDiv.addEventListener('mouseenter', () => {
        lineDiv.style.background = 'rgba(255, 255, 255, 0.04)';
        copyBtn.style.opacity = '1';
        copyBtn.style.color = 'rgba(255, 255, 255, 0.6)';
      });
      lineDiv.addEventListener('mouseleave', () => {
        lineDiv.style.background = 'transparent';
        copyBtn.style.opacity = '0';
        copyBtn.style.color = 'rgba(255, 255, 255, 0.3)';
      });
      
      lineDiv.appendChild(lineNum);
      lineDiv.appendChild(lineContent);
      lineDiv.appendChild(copyBtn);
      linesContainer.appendChild(lineDiv);
    });
    
    pre.appendChild(titleBar);
    pre.appendChild(linesContainer);
  });
});
</script>

<style>
  .hero-logo {
    height: 50px;
    margin-bottom: 15px;
    filter: brightness(0) invert(1);
  }

  .page-hero {
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)),
      url('https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1920&q=80');
    background-size: cover;
    background-position: center;
    padding: 100px 0;
    color: white;
    text-align: center;
  }

  .page-hero h1 {
    font-size: 2.8rem;
    margin-bottom: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .breadcrumb { font-size: 1rem; color: #ccc; }
  .breadcrumb a { color: #fff; text-decoration: none; }
  .breadcrumb a:hover { color: #B82525; }
  .breadcrumb span { margin: 0 10px; color: #B82525; }

  /* --- 文章區塊 --- */
  .article-wrap {
    padding: 60px 0 80px;
    background: #fff;
  }

  .article-inner {
    max-width: 850px;
    margin: 0 auto;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .article-tag {
    background: #333;
    color: white;
    padding: 4px 14px;
    font-size: 0.85rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .article-date,
  .article-author {
    color: #999;
    font-size: 0.95rem;
  }

  .featured-img {
    width: 100%;
    max-height: none;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    margin-bottom: 50px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    background: #f5f5f5;
  }

  /* --- 文章內容排版 --- */
  .article-content {
    font-size: 1.15rem;
    color: #444;
    line-height: 1.9;
    text-align: justify;
  }

  .article-content :global(h2) {
    font-size: 1.8rem;
    color: #333;
    margin: 50px 0 20px;
    font-weight: 700;
    border-left: 6px solid #B82525;
    padding-left: 20px;
  }

  .article-content :global(h3) {
    font-size: 1.4rem;
    color: #333;
    margin: 40px 0 15px;
    font-weight: 700;
  }

  .article-content :global(p) {
    margin-bottom: 25px;
    color: #444;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 30px 0;
    padding-left: 25px;
  }

  .article-content :global(li) {
    margin-bottom: 12px;
    color: #444;
    position: relative;
  }

  .article-content :global(ul li::marker) {
    color: #B82525;
  }

  .article-content :global(strong) {
    color: #333;
    font-weight: 700;
  }

  .article-content :global(a) {
    color: #B82525;
    text-decoration: underline;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid #B82525;
    padding: 15px 20px;
    margin: 30px 0;
    background: #f9f9f9;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #555;
  }

  .article-content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 20px 0;
  }

  /* Code block styling */
  .article-content :global(pre) {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 0;
    border-radius: 12px;
    overflow: hidden;
    margin: 24px 0;
    font-size: 0.9rem;
    line-height: 1.6;
    position: relative;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }

  .article-content :global(pre code) {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.9rem;
    background: none;
    padding: 0;
    color: inherit;
  }

  /* --- 底部導覽 --- */
  .article-footer-nav {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: #666;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.3s;
  }

  .back-link:hover { color: #B82525; }

  .btn {
    display: inline-block;
    padding: 12px 30px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: all 0.3s;
    white-space: nowrap;
  }

  .btn-primary {
    background: #B82525;
    color: white;
    box-shadow: 0 8px 20px rgba(184, 37, 37, 0.4);
  }

  .btn-primary:hover {
    background: #8a1515;
    transform: translateY(-2px);
    color: white;
  }

  /* --- 返回頂部 --- */
  .back-to-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: #B82525;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .back-to-top.show {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    transform: translateY(-5px);
    background: #8a1515;
  }

  @media (max-width: 768px) {
    .page-hero h1 { font-size: 2rem; }
    .article-meta { gap: 12px; }
    .article-footer-nav { flex-direction: column; text-align: center; }
    .back-link { order: 2; }
    .btn-primary { width: 100%; order: 1; }
  }

  /* Code block copy button */
  .copy-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 8px;
    cursor: pointer;
    color: #666;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }
  .copy-btn:hover {
    background: #B82525;
    color: white;
    border-color: #B82525;
  }
  .copy-btn.copied {
    background: #28a745;
    color: white;
    border-color: #28a745;
  }

  /* Line-by-line copy buttons */
  .code-lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  
  .code-line {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 8px;
    border-radius: 4px;
    transition: background 0.2s;
    line-height: 1.6;
  }
  
  .code-line:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .code-line-content {
    flex: 1;
    font-family: 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.9rem;
    color: #333;
  }
  
  .line-copy-btn {
    opacity: 0;
    background: transparent;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: #999;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .code-line:hover .line-copy-btn {
    opacity: 1;
  }
  
  .line-copy-btn:hover {
    color: #B82525;
  }
  
  .line-copy-btn.copied {
    color: #28a745;
  }
  
  .all-copy-btn {
    opacity: 0;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 6px;
    cursor: pointer;
    color: #666;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }
  
  pre:hover .all-copy-btn {
    opacity: 1;
  }
  
  .all-copy-btn:hover {
    background: #B82525;
    color: white;
    border-color: #B82525;
  }
  
  .all-copy-btn.copied {
    background: #28a745;
    color: white;
    border-color: #28a745;
  }
</style>